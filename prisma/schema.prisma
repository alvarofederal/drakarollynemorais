// prisma/schema.prisma
//
// Plataforma de Cursos — Dra. Karollyne Morais
//
// relationMode = "prisma": o MySQL NÃO cria foreign keys. Consequências:
//   1. TODO campo de relação precisa de @@index explícito
//   2. deleção em cascata é responsabilidade da aplicação
//   3. integridade referencial é responsabilidade da aplicação
//
// Documentação do modelo: spec.md → Parte 8

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ─────────────────────────────────────────
// AUTENTICAÇÃO
// ─────────────────────────────────────────

/// Dois papéis, conforme definido com a Dra.:
/// ADMIN — ela. Sobe material, gerencia cursos, alunos e a plataforma inteira.
/// ALUNO — quem consome os cursos.
enum Role {
  ADMIN
  ALUNO
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  /// Conta criada pelo download do livro, sem senha definida ainda
  DEFINIR_SENHA
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(ALUNO)

  /// Necessário para emitir o certificado. Opcional no cadastro,
  /// exigido antes da emissão.
  cpf      String? @unique @db.VarChar(14)
  telefone String? @db.VarChar(20)

  ativo        Boolean   @default(true)
  ultimoAcesso DateTime?

  accounts   Account[]
  sessions   Session[]
  authTokens AuthToken[]

  matriculas   Matricula[]
  progressos   ProgressoAula[]
  certificados Certificado[]
  pedidos      Pedido[]
  assinaturas  Assinatura[]
  downloads    DownloadEbook[]
  logsEventos  LogEvento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([role])
  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Mantida por compatibilidade com o PrismaAdapter.
/// A sessão da aplicação é JWT — esta tabela não é escrita no fluxo normal.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

/// Tokens de verificação de e-mail e redefinição de senha.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique @db.VarChar(191)
  type      TokenType
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// Base do bloqueio por tentativas de login (ver lib/rate-limit.ts).
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_attempts")
}

// ─────────────────────────────────────────
// CONTEÚDO
// ─────────────────────────────────────────

enum StatusCurso {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

enum NivelCurso {
  INTRODUTORIO
  INTERMEDIARIO
  AVANCADO
}

enum TipoAcesso {
  VITALICIO
  PRAZO_DIAS
}

enum TipoAula {
  VIDEO
  TEXTO
  PDF
}

enum TipoMaterial {
  PDF
  SLIDE
  PLANILHA
  LINK
  IMAGEM
}

/// Professor convidado. É metadado exibido do curso — NÃO é usuário do sistema.
/// A Dra. publica o conteúdo em nome dele.
model Professor {
  id            String  @id @default(cuid())
  nome          String
  slug          String  @unique
  titulacao     String?
  crm           String? @db.VarChar(30)
  rqe           String? @db.VarChar(30)
  especialidade String?
  bio           String? @db.Text
  fotoUrl       String?
  instagram     String?

  cursos Curso[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("professores")
}

model Categoria {
  id    String @id @default(cuid())
  nome  String
  slug  String @unique
  ordem Int    @default(0)

  cursos Curso[]

  @@map("categorias")
}

model Curso {
  id        String  @id @default(cuid())
  slug      String  @unique
  titulo    String
  subtitulo String?
  descricao String? @db.Text

  capaUrl         String?
  /// UID do vídeo de apresentação no Cloudflare Stream
  trailerVideoUid String?

  professorId String?
  categoriaId String?

  nivel               NivelCurso @default(INTRODUTORIO)
  cargaHorariaMinutos Int        @default(0)

  precoCentavos   Int     @default(0)
  /// Preço "de" — apenas para exibição de desconto
  precoDeCentavos Int?
  stripePriceId   String?

  tipoAcesso TipoAcesso @default(PRAZO_DIAS)
  /// Dias de acesso quando tipoAcesso = PRAZO_DIAS
  acessoDias Int?       @default(365)

  status      StatusCurso @default(RASCUNHO)
  publicadoEm DateTime?

  emiteCertificado          Boolean @default(true)
  percentualParaCertificado Int     @default(100)

  destaque Boolean @default(false)
  ordem    Int     @default(0)

  professor Professor? @relation(fields: [professorId], references: [id])
  categoria Categoria? @relation(fields: [categoriaId], references: [id])

  modulos      Modulo[]
  materiais    Material[]
  matriculas   Matricula[]
  pedidos      Pedido[]
  certificados Certificado[]
  depoimentos  Depoimento[]
  faqs         Faq[]
  cupons       Cupom[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([professorId])
  @@index([categoriaId])
  @@index([status])
  @@map("cursos")
}

model Modulo {
  id        String  @id @default(cuid())
  cursoId   String
  titulo    String
  descricao String? @db.Text
  capaUrl   String?
  ordem     Int     @default(0)

  /// Liberação programada (drip content) — v1.1
  liberacaoDias Int?

  curso Curso  @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  aulas Aula[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([cursoId])
  @@map("modulos")
}

model Aula {
  id        String  @id @default(cuid())
  moduloId  String
  slug      String
  titulo    String
  /// Texto do balão que explica o que a aula cobre
  descricao String? @db.Text
  /// Capa do card. Cada aula tem a sua — é o que monta a fileira.
  capaUrl   String?

  tipo TipoAula @default(VIDEO)

  /// Transmissão ao vivo: o Cloudflare grava e a gravação vira aula
  ehLive Boolean   @default(false)
  liveEm DateTime?

  /// UID do vídeo no Cloudflare Stream. Nulo até o upload terminar.
  videoUid        String?
  /// Preenchido pelo webhook do Stream quando o vídeo fica pronto
  duracaoSegundos Int?
  videoPronto     Boolean @default(false)

  ordem Int @default(0)

  /// Aula de amostra: única exceção ao portão de matrícula
  gratuita  Boolean @default(false)
  publicada Boolean @default(false)

  modulo     Modulo          @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  materiais  Material[]
  progressos ProgressoAula[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([moduloId, slug])
  @@index([moduloId])
  @@map("aulas")
}

/// Material de apoio. Pertence a uma aula OU ao curso inteiro.
model Material {
  id      String  @id @default(cuid())
  aulaId  String?
  cursoId String?

  titulo String
  tipo   TipoMaterial @default(PDF)

  /// Chave do objeto no bucket privado (Cloudflare R2).
  /// NUNCA exposta a usuário sem matrícula — ver lib/acesso.ts
  arquivoKey   String
  tamanhoBytes Int    @default(0)

  downloadPermitido Boolean @default(true)
  ordem             Int     @default(0)

  aula  Aula?  @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  curso Curso? @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@index([aulaId])
  @@index([cursoId])
  @@map("materiais")
}

// ─────────────────────────────────────────
// ACESSO E PROGRESSO
// ─────────────────────────────────────────

enum OrigemMatricula {
  COMPRA
  CORTESIA
  IMPORTACAO
}

enum StatusMatricula {
  ATIVA
  EXPIRADA
  CANCELADA
  REEMBOLSADA
}

/// O portão de acesso ao conteúdo. Sem matrícula ATIVA, nada é entregue.
model Matricula {
  id       String  @id @default(cuid())
  userId   String
  cursoId  String
  pedidoId String?

  origem OrigemMatricula @default(COMPRA)
  status StatusMatricula @default(ATIVA)

  iniciadaEm  DateTime  @default(now())
  /// Nulo = acesso vitalício
  expiraEm    DateTime?
  concluidaEm DateTime?

  percentualConcluido Int @default(0)

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  curso       Curso           @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  progressos  ProgressoAula[]
  certificado Certificado?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([userId, cursoId])
  @@index([userId])
  @@index([cursoId])
  @@index([status])
  @@map("matriculas")
}

model ProgressoAula {
  id          String @id @default(cuid())
  userId      String
  aulaId      String
  matriculaId String

  segundosAssistidos Int @default(0)
  /// Posição para retomar de onde parou
  ultimaPosicao      Int @default(0)

  concluida   Boolean   @default(false)
  concluidaEm DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aula      Aula      @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  matricula Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([userId, aulaId])
  @@index([userId])
  @@index([aulaId])
  @@index([matriculaId])
  @@map("progresso_aulas")
}

/// Documento imutável. Os campos de conteúdo são snapshot: mudar o curso
/// depois NÃO altera certificados já emitidos.
model Certificado {
  id          String @id @default(cuid())
  /// Código público de validação, ex.: KM-2026-A7F3C9
  codigo      String @unique @db.VarChar(40)
  userId      String
  cursoId     String
  matriculaId String @unique

  nomeAluno           String
  cpfAluno            String? @db.VarChar(14)
  cursoTitulo         String
  cargaHorariaMinutos Int

  emitidoEm DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  curso     Curso     @relation(fields: [cursoId], references: [id])
  matricula Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cursoId])
  @@map("certificados")
}

// ─────────────────────────────────────────
// COMÉRCIO
// ─────────────────────────────────────────

enum StatusPedido {
  PENDENTE
  PAGO
  FALHOU
  REEMBOLSADO
}

enum TipoCupom {
  PERCENTUAL
  VALOR_FIXO
}

model Pedido {
  id      String @id @default(cuid())
  userId  String
  cursoId String

  /// Chave de idempotência do webhook do Stripe
  stripeSessionId       String  @unique @db.VarChar(191)
  stripePaymentIntentId String?

  valorCentavos Int
  cupomId       String?

  status StatusPedido @default(PENDENTE)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  curso Curso  @relation(fields: [cursoId], references: [id])
  cupom Cupom? @relation(fields: [cupomId], references: [id])

  criadoEm DateTime  @default(now())
  pagoEm   DateTime?

  @@index([userId])
  @@index([cursoId])
  @@index([cupomId])
  @@index([status])
  @@map("pedidos")
}

model Cupom {
  id     String    @id @default(cuid())
  codigo String    @unique @db.VarChar(60)
  tipo   TipoCupom @default(PERCENTUAL)
  valor  Int

  /// Nulo = vale para qualquer curso
  cursoId     String?
  usosMaximos Int?
  usosAtuais  Int       @default(0)
  validoAte   DateTime?
  ativo       Boolean   @default(true)

  curso   Curso?   @relation(fields: [cursoId], references: [id])
  pedidos Pedido[]

  criadoEm DateTime @default(now())

  @@index([cursoId])
  @@map("cupons")
}

// ─────────────────────────────────────────
// MARKETING E OPERAÇÃO
// ─────────────────────────────────────────

/// Depoimento de ALUNO sobre o curso.
/// ⚠️ Nunca depoimento de paciente sobre tratamento — vedado pelo CFM.
model Depoimento {
  id      String  @id @default(cuid())
  cursoId String?

  nome    String
  cargo   String?
  fotoUrl String?
  texto   String  @db.Text
  nota    Int?

  aprovado Boolean @default(false)
  ordem    Int     @default(0)

  curso Curso? @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@index([cursoId])
  @@map("depoimentos")
}

model Faq {
  id      String  @id @default(cuid())
  cursoId String?

  pergunta String
  resposta String @db.Text
  ordem    Int    @default(0)

  curso Curso? @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@index([cursoId])
  @@map("faqs")
}

/// Registro único (singleton) com a marca e os textos editáveis da plataforma.
model ConfigPlataforma {
  id String @id @default("default")

  nomeMarca   String  @default("Dra. Karollyne Morais")
  logoUrl     String?
  corPrimaria String? @db.VarChar(20)

  whatsapp     String?
  instagram    String?
  emailContato String?
  razaoSocial  String?
  cnpj         String? @db.VarChar(20)

  /// Textos da landing sobrescritos pelo painel
  textosLanding Json?

  atualizadoEm DateTime @updatedAt

  @@map("config_plataforma")
}

enum TipoEvento {
  MATRICULA_CRIADA
  MATRICULA_REVOGADA
  PAGAMENTO_APROVADO
  PAGAMENTO_REEMBOLSADO
  CURSO_PUBLICADO
  AULA_PUBLICADA
  CERTIFICADO_EMITIDO
  LOGIN
  CADASTRO
  ASSINATURA_CRIADA
  ASSINATURA_CANCELADA
  EBOOK_BAIXADO
}

/// Trilha de auditoria. Registro imutável de cada ação relevante.
model LogEvento {
  id     String     @id @default(cuid())
  userId String?
  tipo   TipoEvento

  entidade   String?
  entidadeId String?
  metadata   Json?
  ip         String? @db.VarChar(45)

  user User? @relation(fields: [userId], references: [id])

  criadoEm DateTime @default(now())

  @@index([userId])
  @@index([tipo])
  @@index([criadoEm])
  @@map("logs_eventos")
}

// ─────────────────────────────────────────
// COMUNIDADE (assinatura recorrente)
// ─────────────────────────────────────────

enum IntervaloPlano {
  MENSAL
  ANUAL
}

enum StatusAssinatura {
  ATIVA
  INADIMPLENTE
  CANCELADA
  EXPIRADA
}

/// Plano da comunidade. É tabela, e não constante no código, justamente para
/// permitir reajuste sem precisar de deploy.
model Plano {
  id            String         @id @default(cuid())
  nome          String
  slug          String         @unique
  descricao     String?        @db.Text
  /// Preço vigente para NOVAS adesões
  precoCentavos Int
  intervalo     IntervaloPlano @default(MENSAL)
  ativo         Boolean        @default(true)
  stripePriceId String?

  assinaturas Assinatura[]
  reajustes   ReajustePlano[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("planos")
}

/// Histórico e agendamento de reajustes.
model ReajustePlano {
  id            String    @id @default(cuid())
  planoId       String
  precoAnterior Int
  precoNovo     Int
  /// Quando passa a valer para quem JÁ é assinante
  vigenteEm     DateTime
  /// Nulo enquanto agendado; preenchido quando aplicado
  aplicadoEm    DateTime?
  observacao    String?

  plano Plano @relation(fields: [planoId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@index([planoId])
  @@map("reajustes_plano")
}

/// Assinatura da comunidade: dá acesso a todos os cursos enquanto ativa.
model Assinatura {
  id      String           @id @default(cuid())
  userId  String
  planoId String
  status  StatusAssinatura @default(ATIVA)

  /// Preço que ESTE assinante paga. Congelado na adesão — é o que impede um
  /// reajuste de atingir retroativamente quem entrou antes dele.
  valorCentavos Int

  iniciadaEm DateTime @default(now())
  /// Fim do período já pago
  renovaEm   DateTime

  canceladaEm DateTime?
  /// Até quando o acesso continua depois de cancelar
  acessoAte   DateTime?

  stripeSubscriptionId String? @unique
  stripeCustomerId     String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plano Plano @relation(fields: [planoId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([userId])
  @@index([planoId])
  @@index([status])
  @@map("assinaturas")
}

// ─────────────────────────────────────────
// LIVRO (isca de entrada)
// ─────────────────────────────────────────

model Ebook {
  id        String  @id @default(cuid())
  slug      String  @unique
  titulo    String
  subtitulo String?
  descricao String? @db.Text
  capaUrl   String?

  /// Chave do objeto no bucket privado (R2). Nunca é URL pública.
  arquivoKey String
  paginas    Int?

  publicado Boolean @default(false)

  downloads DownloadEbook[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("ebooks")
}

model DownloadEbook {
  id      String  @id @default(cuid())
  ebookId String
  userId  String
  /// De onde veio a pessoa: utm_source, "instagram", "bio"…
  origem  String?
  ip      String? @db.VarChar(45)

  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@index([ebookId])
  @@index([userId])
  @@map("downloads_ebook")
}
